# En-têtes HTTP envoyés par Netlify. server.mjs pose les mêmes en local.
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(self), gyroscope=(self), magnetometer=(self), screen-wake-lock=(self), geolocation=(), camera=(), microphone=()

# Le navigateur doit toujours revalider sw.js, sinon une mise à jour peut rester invisible.
/sw.js
  Cache-Control: no-cache

# La jumelle Markdown reste lisible par les agents sans concurrencer la page HTML dans Google.
/*.md
  X-Robots-Tag: noindex
